<?xml version="1.0" encoding="UTF-8"?>
<!--SRDF do manipulador RAV (3R planar + garra). Reescrito para a geometria real:
    sem referência ao arm_link_2_endlink (removido) e com poses dentro dos limites.
    Grupos/juntas mantidos para compatibilidade com kinematics/controllers. -->
<robot name="rav_arm">

    <group name="arm">
        <joint name="arm_joint_2"/>
        <joint name="arm_joint_3"/>
        <joint name="arm_joint_4"/>
    </group>
    <group name="gripper">
        <joint name="arm_gripper_joint_1"/>
        <joint name="arm_gripper_joint_2"/>
    </group>

    <group_state name="home" group="arm">
        <joint name="arm_joint_2" value="0.0"/>
        <joint name="arm_joint_3" value="0.0"/>
        <joint name="arm_joint_4" value="0.0"/>
    </group_state>
    <group_state name="ready" group="arm">
        <joint name="arm_joint_2" value="0.6"/>
        <joint name="arm_joint_3" value="0.9"/>
        <joint name="arm_joint_4" value="0.4"/>
    </group_state>

    <group_state name="open" group="gripper">
        <joint name="arm_gripper_joint_1" value="0.03"/>
    </group_state>
    <group_state name="closed" group="gripper">
        <joint name="arm_gripper_joint_1" value="0.0"/>
    </group_state>

    <end_effector name="gripper" parent_link="arm_link_4" group="gripper"/>

    <virtual_joint name="virtual_joint" type="fixed" parent_frame="world" child_link="arm_world"/>

    <disable_collisions link1="arm_base_link"        link2="arm_link_2"           reason="Adjacent"/>
    <disable_collisions link1="arm_link_2"           link2="arm_link_3"           reason="Adjacent"/>
    <disable_collisions link1="arm_link_3"           link2="arm_link_4"           reason="Adjacent"/>
    <disable_collisions link1="arm_link_4"           link2="arm_gripper_link_1"   reason="Adjacent"/>
    <disable_collisions link1="arm_link_4"           link2="arm_gripper_link_2"   reason="Adjacent"/>
    <disable_collisions link1="arm_link_4"           link2="arm_gripper_frame_cp" reason="Adjacent"/>
    <disable_collisions link1="arm_gripper_link_1"   link2="arm_gripper_link_2"   reason="Never"/>
    <disable_collisions link1="arm_link_3"           link2="arm_gripper_link_1"   reason="Never"/>
    <disable_collisions link1="arm_link_3"           link2="arm_gripper_link_2"   reason="Never"/>
    <disable_collisions link1="arm_link_3"           link2="arm_gripper_frame_cp" reason="Never"/>
</robot>
