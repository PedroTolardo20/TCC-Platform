<?xml version="1.0"?>
<!-- Standalone robot used by the MoveIt demo, with mock ros2_control hardware. -->
<robot name="rav_manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="use_fake_hardware" default="true"/>
  <xacro:include filename="$(find rav_description)/urdf/rav_manipulator.urdf.xacro"/>

  <link name="manipulator_world"/>
  <xacro:rav_manipulator
      parent_link="manipulator_world"
      mount_xyz="0 0 0"
      mount_rpy="0 0 0"
      use_fake_hardware="false"/>

  <!-- Plugin RAV em modo seguro: não abre serial nem movimenta motores. -->
  <ros2_control name="RavManipuladorDynamixelDryRun" type="system">
    <hardware>
      <plugin>rav_dynamixel_hardware/RavDynamixelHardware</plugin>
      <param name="dry_run">true</param>
    </hardware>

    <joint name="shoulder_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="elbow_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="wrist_joint">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

</robot>
