<?xml version="1.0" encoding="UTF-8"?>
<robot name="rav_manipulator">
  <group name="rav_arm">
    <chain base_link="manipulator_base_link" tip_link="gripper_pinion_link"/>
  </group>

  <group_state name="cad_reference" group="rav_arm">
    <joint name="shoulder_joint" value="0.0"/>
    <joint name="elbow_joint" value="0.0"/>
    <joint name="wrist_joint" value="0.0"/>
    <joint name="gripper_pinion_joint" value="0.0"/>
  </group_state>

  <virtual_joint
      name="virtual_joint"
      type="fixed"
      parent_frame="world"
      child_link="manipulator_world"/>

  <!--
    Gerado com o collisions_updater do moveit_setup_assistant (flags
    default, always e keep), a mesma matriz que o Setup Assistant
    calcularia. "Adjacent"/"Never"/"Default": achados automaticamente
    pela ferramenta. "Design": mantidos manualmente — cremalheira e
    pinhão engrenam por design, então as meshes se tocam/cruzam durante
    a operação normal, não é colisão real.
  -->
  <disable_collisions link1="elbow_link" link2="gripper_base_link" reason="Never"/>
  <disable_collisions link1="elbow_link" link2="gripper_pinion_link" reason="Never"/>
  <disable_collisions link1="elbow_link" link2="left_finger_link" reason="Never"/>
  <disable_collisions link1="elbow_link" link2="right_finger_link" reason="Never"/>
  <disable_collisions link1="elbow_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="elbow_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="gripper_pinion_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="manipulator_base_link" reason="Never"/>
  <disable_collisions link1="gripper_base_link" link2="right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="gripper_base_link" link2="wrist_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_pinion_link" link2="left_finger_link" reason="Design"/>
  <disable_collisions link1="gripper_pinion_link" link2="manipulator_base_link" reason="Never"/>
  <disable_collisions link1="gripper_pinion_link" link2="right_finger_link" reason="Design"/>
  <disable_collisions link1="gripper_pinion_link" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="gripper_pinion_link" link2="wrist_link" reason="Default"/>
  <disable_collisions link1="left_finger_link" link2="manipulator_base_link" reason="Never"/>
  <disable_collisions link1="left_finger_link" link2="right_finger_link" reason="Design"/>
  <disable_collisions link1="left_finger_link" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="left_finger_link" link2="wrist_link" reason="Never"/>
  <disable_collisions link1="manipulator_base_link" link2="right_finger_link" reason="Never"/>
  <disable_collisions link1="manipulator_base_link" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="right_finger_link" link2="shoulder_link" reason="Never"/>
  <disable_collisions link1="right_finger_link" link2="wrist_link" reason="Never"/>
  <disable_collisions link1="shoulder_link" link2="wrist_link" reason="Never"/>

  <!-- Poses validadas visualmente no CAD/RViz -->
  <group_state name="home" group="rav_arm">
    <joint name="shoulder_joint" value="-0.4200"/>
    <joint name="elbow_joint" value="1.1800"/>
    <joint name="wrist_joint" value="0.8240"/>
    <joint name="gripper_pinion_joint" value="0.0"/>
  </group_state>

  <group_state name="ready" group="rav_arm">
    <joint name="shoulder_joint" value="-0.4200"/>
    <joint name="elbow_joint" value="0.4252"/>
    <joint name="wrist_joint" value="1.5707"/>
    <joint name="gripper_pinion_joint" value="0.0"/>
  </group_state>

</robot>
