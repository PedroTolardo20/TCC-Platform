<?xml version="1.0"?>
<sdf version="1.8">
  <model name="rav_pick_scene">
    <static>true</static>

    <!-- Topo em z=0.80 m. A caixa fica perto da borda voltada ao braço. -->
    <link name="scene_link">
      <collision name="table_collision">
        <pose>0.45 0 0.40 0 0 0</pose>
        <geometry>
          <box>
            <size>0.50 0.50 0.80</size>
          </box>
        </geometry>
      </collision>
      <visual name="table_visual">
        <pose>0.45 0 0.40 0 0 0</pose>
        <geometry>
          <box>
            <size>0.50 0.50 0.80</size>
          </box>
        </geometry>
        <material>
          <ambient>0.30 0.18 0.08 1</ambient>
          <diffuse>0.46 0.28 0.12 1</diffuse>
        </material>
      </visual>

      <!-- Caixa 5 x 5 x 8 cm. Centro em z=0.84; topo em z=0.88. -->
      <collision name="product_collision">
        <pose>0.30 0 0.84 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.08</size>
          </box>
        </geometry>
      </collision>
      <visual name="product_visual">
        <pose>0.30 0 0.84 0 0 0</pose>
        <geometry>
          <box>
            <size>0.05 0.05 0.08</size>
          </box>
        </geometry>
        <material>
          <ambient>0.05 0.14 0.75 1</ambient>
          <diffuse>0.08 0.22 1.00 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
