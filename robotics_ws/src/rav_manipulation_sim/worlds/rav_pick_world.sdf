<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="default">
    <gravity>0 0 -9.81</gravity>

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Sistemas mínimos do Gazebo Fortress: física, spawn e visualização. -->
    <plugin
      filename="ignition-gazebo-physics-system"
      name="ignition::gazebo::systems::Physics"/>
    <plugin
      filename="ignition-gazebo-user-commands-system"
      name="ignition::gazebo::systems::UserCommands"/>
    <plugin
      filename="ignition-gazebo-scene-broadcaster-system"
      name="ignition::gazebo::systems::SceneBroadcaster"/>


    <!-- Necessário para câmeras, depth cameras e demais sensores. -->
    <plugin
      filename="ignition-gazebo-sensors-system"
      name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Mesa: topo em z=0.80 m, mesma geometria usada na Planning Scene. -->
    <model name="pick_table">
      <static>true</static>
      <pose>0.70 0.00 0.40 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.50 0.50 0.80</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.50 0.50 0.80</size>
            </box>
          </geometry>
          <material>
            <ambient>0.22 0.11 0.04 1</ambient>
            <diffuse>0.46 0.26 0.10 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Produto azul: 5 x 5 x 8 cm, centro em z=0.84 m, topo em z=0.88 m. -->
    <model name="blue_product">
      <static>true</static>
      <pose>0.55 0.00 0.86 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.05 0.045 0.12</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.05 0.045 0.12</size>
            </box>
          </geometry>
          <material>
            <ambient>0.90 0.90 0.90 1</ambient>
            <diffuse>0.98 0.98 0.98 1</diffuse>
            <specular>0.20 0.20 0.20 1</specular>
          </material>
        </visual>

        <!--
          Imagem frontal da embalagem usada no treinamento.
          É uma camada visual fina; a colisão continua sendo a caixa original.
        -->
        <visual name="bepantol_label_visual">
          <!-- Face da caixa voltada para a câmera. -->
          <pose>-0.0256 0 0 0 0 0</pose>

          <geometry>
            <box>
              <!--
                Espessura mínima, largura proporcional à imagem
                e altura próxima à altura total da embalagem.
              -->
              <size>0.0008 0.042 0.116</size>
            </box>
          </geometry>

          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>

            <pbr>
              <metal>
                <albedo_map>
                  model://rav_manipulation_sim/materials/textures/bepantol_front_texture.png
                </albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.8</roughness>
              </metal>
            </pbr>
          </material>
        </visual>

      </link>
    </model>
  </world>
</sdf>
