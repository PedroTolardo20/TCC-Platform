<?xml version="1.0"?>
<!--
  Modelo do manipulador do TCC do RAV.

  Escopo desta primeira etapa
  - 3 juntas revolutas: shoulder_joint, elbow_joint e wrist_joint.
  - Os três eixos são paralelos e usam +X como eixo de rotação.
  - As meshes são as STLs originais exportadas do Shapr3D.
  - A garra e o Dynamixel 4 permanecem fora deste arquivo até o CAD da garra
    e o frame final de montagem serem definidos.

  Observação sobre o horn
  O STL recebido do Dynamixel contém a carcaça e o horn como um único corpo.
  No URDF, o centro do horn é a origem cinemática da junta. Visualmente, o
  horn permanece junto com o corpo do motor porque não existe uma mesh separada
  para ele; isso não altera a cinemática do braço.
-->
<robot name="rav_manipulator" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Propriedades físicas provisórias para Gazebo.
    Não interferem no controle dos Dynamixel reais.
    Substituir futuramente por massas e tensores medidos/calculados.
  -->
  <xacro:macro
      name="rav_provisional_inertial"
      params="mass xyz ixx iyy izz">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
          ixx="${ixx}" ixy="0.0" ixz="0.0"
          iyy="${iyy}" iyz="0.0"
          izz="${izz}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="rav_manipulator"
               params="parent_link mount_xyz:='0 0 0' mount_rpy:='0 0 0' use_fake_hardware:=false">

    <!--
      Referência geométrica extraída da pose CAD recebida, em metros.
      J1 = eixo do horn do Dynamixel 1
      J2 = eixo do horn do Dynamixel 2
      J3 = eixo do horn do Dynamixel 3

      As transforms J1→J2 e J2→J3 definem a pose zero no CAD. Não são os
      comprimentos nominais do TCC; são as distâncias centro-a-centro reais
      da montagem exportada.
    -->
    <xacro:property name="j1_to_j2_y" value="0.000029639983"/>
    <xacro:property name="j1_to_j2_z" value="0.289118072919"/>
    <xacro:property name="j2_to_j3_y" value="-0.334030187591"/>
    <xacro:property name="j2_to_j3_z" value="-0.000015558969"/>

    <!-- Limites provisórios: somente para RViz/MoveIt sem hardware real. -->
    <xacro:property name="joint_lower_limit" value="${-pi / 2.0}"/>
    <xacro:property name="joint_upper_limit" value="${ pi / 2.0}"/>
    <xacro:property name="joint_effort_limit" value="10.0"/>
    <xacro:property name="joint_velocity_limit" value="0.50"/>

    <material name="rav_manipulator_motor">
      <color rgba="0.16 0.16 0.16 1.0"/>
    </material>
    <material name="rav_manipulator_structure">
      <color rgba="0.58 0.58 0.60 1.0"/>
    </material>

    <!--
      Mount externo. No modo standalone, o parent é manipulator_world.
      Na integração final com o RAV, o parent será um frame da estrutura
      interna e mount_xyz/mount_rpy serão medidos no CAD completo.
    -->
    <joint name="rav_manipulator_mount_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="manipulator_base_link"/>
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
    </joint>

    <!--
      Dynamixel 1: a carcaça é fixada diretamente à estrutura interna do RAV.
      O origin abaixo leva o centro do horn do STL para a origem do link.
    -->
    <link name="manipulator_base_link">
      <xacro:rav_provisional_inertial
          mass="1.0"
          xyz="0 0 0"
          ixx="0.004" iyy="0.004" izz="0.004"/>
      <visual>
        <origin xyz="0 0.047471563258 -0.733684638388" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/dynamixel_xm540.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="rav_manipulator_motor"/>
      </visual>
      <collision>
        <origin xyz="0 0.047471563258 -0.733684638388" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/dynamixel_xm540.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- J1: o horn do Dynamixel 1 movimenta U aço 1 + Link 1. -->
    <joint name="shoulder_joint" type="revolute">
      <parent link="manipulator_base_link"/>
      <child link="shoulder_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${joint_lower_limit}" upper="${joint_upper_limit}"
             effort="${joint_effort_limit}" velocity="${joint_velocity_limit}"/>
    </joint>

    <!--
      Conjunto rígido do primeiro elo:
      U aço 1 + Link 1 + carcaça fixa do Dynamixel 2.
    -->
    <link name="shoulder_link">
      <xacro:rav_provisional_inertial
          mass="1.5"
          xyz="0 0.000015 0.139059"
          ixx="0.010" iyy="0.010" izz="0.002"/>
      <visual>
        <origin xyz="0 0.047471563258 -0.733684638388" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/link_1_assembly.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="rav_manipulator_structure"/>
      </visual>
      <collision>
        <origin xyz="0 0.047471563258 -0.733684638388" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/link_1_assembly.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <!-- Corpo do Dynamixel 2, fixo no Link 1. -->
      <visual>
        <origin xyz="0 0.047501203241 -0.444566565469" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/dynamixel_xm540.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="rav_manipulator_motor"/>
      </visual>
      <collision>
        <origin xyz="0 0.047501203241 -0.444566565469" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/dynamixel_xm540.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- J2: o horn do Dynamixel 2 movimenta U aço 2 + Link 2. -->
    <joint name="elbow_joint" type="revolute">
      <parent link="shoulder_link"/>
      <child link="elbow_link"/>
      <origin xyz="0 ${j1_to_j2_y} ${j1_to_j2_z}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${joint_lower_limit}" upper="${joint_upper_limit}"
             effort="${joint_effort_limit}" velocity="${joint_velocity_limit}"/>
    </joint>

    <!--
      Conjunto rígido do segundo elo:
      U aço 2 + Link 2 + carcaça fixa do Dynamixel 3.
    -->
    <link name="elbow_link">
      <xacro:rav_provisional_inertial
          mass="1.2"
          xyz="0 -0.171515 0"
          ixx="0.012" iyy="0.002" izz="0.012"/>
      <visual>
        <origin xyz="0 0.047441923275 -1.011802711307" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/link_2_assembly.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="rav_manipulator_structure"/>
      </visual>
      <collision>
        <origin xyz="0 0.047441923275 -1.011802711307" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/link_2_assembly.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <!--
        Corpo do Dynamixel 3, fixo no Link 2.
        O mesmo STL do Dynamixel 1 é reutilizado, mas com rotação de +90°
        no eixo X. Assim, a carcaça fica alojada no interior da ponta do
        Link 2, mantendo o centro do horn exatamente em J3.
      -->
      <visual>
        <origin xyz="0 0.399654450797 0.047456004289" rpy="1.57079632679 0 0"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/dynamixel_xm540.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="rav_manipulator_motor"/>
      </visual>
      <collision>
        <origin xyz="0 0.399654450797 0.047456004289" rpy="1.57079632679 0 0"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/dynamixel_xm540.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>

    <!-- J3: o horn do Dynamixel 3 movimenta U aço 3 e a futura garra. -->
    <joint name="wrist_joint" type="revolute">
      <parent link="elbow_link"/>
      <child link="wrist_link"/>
      <origin xyz="0 ${j2_to_j3_y} ${j2_to_j3_z}" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="${joint_lower_limit}" upper="${joint_upper_limit}"
             effort="${joint_effort_limit}" velocity="${joint_velocity_limit}"/>
    </joint>

    <!-- U aço 3, onde o Dynamixel 4 será fixado quando a garra entrar. -->
    <link name="wrist_link">
      <xacro:rav_provisional_inertial
          mass="0.8"
          xyz="0 0 0"
          ixx="0.004" iyy="0.004" izz="0.004"/>
      <visual>
        <origin xyz="0 0.390472110866 -1.011787152338" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/wrist_assembly.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="rav_manipulator_structure"/>
      </visual>
      <collision>
        <origin xyz="0 0.390472110866 -1.011787152338" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/wrist_assembly.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <!--
        Dynamixel 4: mesma geometria do XM540, rigidamente preso ao U aço 3.
        Não é uma junta do braço: neste estágio ele é apenas a visualização e
        a colisão do atuador que será usado futuramente para a gripper.

        Correção de orientação:
        - a rotação anterior em X colocava o corpo do motor na vertical;
        - a pose abaixo parte da orientação de montagem anterior e adiciona
          +90° no eixo Z, como no CAD do Shapr3D;
        - a translação mantém o centro do horn no mesmo ponto do U aço 3.
      -->
      <visual>
        <origin xyz="-0.718 -0.0619 0.0499"
                rpy="1.57079632679 0 1.57079632679"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/dynamixel_xm540.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
        <material name="rav_manipulator_motor"/>
      </visual>
      <collision>
        <origin xyz="-0.718 -0.0619 0.0499"
                rpy="1.57079632679 0 1.57079632679"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/manipulator/dynamixel_xm540.stl"
                scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
    </link>


    <!--
      Ponto terminal provisório do terceiro elo.
      Não representa uma garra; representa a ponta física usada nos testes
      de alcance do manipulador sem gripper.
    -->
    <link name="wrist_tip">
      <visual>
        <geometry>
          <sphere radius="0.015"/>
        </geometry>
        <material name="wrist_tip_material">
          <color rgba="1.0 0.0 0.0 1.0"/>
        </material>
      </visual>
    </link>

    <joint name="wrist_tip_joint" type="fixed">
      <parent link="wrist_link"/>
      <child link="wrist_tip"/>
      <origin xyz="0 -0.120 0" rpy="0 0 0"/>
    </joint>

    <!-- Frame neutro para a futura garra. A posição final ainda não foi presumida. -->
    <link name="gripper_mount"/>
    <joint name="gripper_mount_joint" type="fixed">
      <parent link="wrist_link"/>
      <child link="gripper_mount"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Simulação somente para o demo do MoveIt, sem OpenCM/Dynamixel físico. -->
    <xacro:if value="${use_fake_hardware}">
      <ros2_control name="RavManipulatorFakeSystem" type="system">
        <hardware>
          <plugin>mock_components/GenericSystem</plugin>
        </hardware>
        <joint name="shoulder_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="elbow_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
        <joint name="wrist_joint">
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
        </joint>
      </ros2_control>
    </xacro:if>

  </xacro:macro>
</robot>
