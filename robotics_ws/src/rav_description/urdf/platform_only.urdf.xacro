<?xml version="1.0"?>
<robot name="rav_platform" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Base Temi Platform -->
  <xacro:property name="platform_diameter" value="0.50"/>
  <xacro:property name="platform_radius" value="${platform_diameter/2.0}"/>
  <xacro:property name="platform_height" value="0.24"/>

  <!-- Rodas -->
  <xacro:property name="wheel_radius" value="0.08"/>
  <xacro:property name="wheel_width"  value="0.05"/>

  <!-- Mantido como você colocou -->
  <xacro:property name="wheel_y" value="${platform_radius + wheel_width/2.0 - 0.43}"/>
  <xacro:property name="wheel_z" value="${wheel_radius}"/>

  <!-- raiz -->
  <link name="base_link"/>

  <link name="platform_base_link">
    <visual>
      <origin xyz="0 0 ${platform_height/2.0 + wheel_width/2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${platform_radius}" length="${platform_height}"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 ${platform_height/2.0 + wheel_width/2.0}" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${platform_radius}" length="${platform_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${platform_height/2.0 + wheel_width/2.0}" rpy="0 0 0"/>
      <mass value="35.0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <joint name="base_to_platform" type="fixed">
    <parent link="base_link"/>
    <child link="platform_base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Roda esquerda -->
  <link name="wheel_left_link">
    <visual>
      <!-- NÃO coloca xyz aqui pra não duplicar deslocamento -->
      <!-- Mantido seu rpy -->
      <origin xyz="0 0 0" rpy="0 1.5708 1.5708"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="wheel_left_joint" type="continuous">
    <parent link="platform_base_link"/>
    <child link="wheel_left_link"/>
    <!-- MANTIDO: a posição escolhida por você -->
    <origin xyz="0 ${wheel_y} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- Roda direita -->
  <link name="wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 1.5708"/>
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
      </geometry>
      <material name="wheel_black">
        <color rgba="0.05 0.05 0.05 1.0"/>
      </material>
    </visual>
  </link>

  <joint name="wheel_right_joint" type="continuous">
    <parent link="platform_base_link"/>
    <child link="wheel_right_link"/>
    <!-- MANTIDO: a posição escolhida por você -->
    <origin xyz="0 ${-wheel_y} ${wheel_z}" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
  </joint>

</robot>
