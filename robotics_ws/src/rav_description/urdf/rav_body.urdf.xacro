<?xml version="1.0"?>
<robot name="rav_body" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="rav_body" params="parent_link:=platform_base_link xyz:='0 0 0.2572' rpy:='0 0 0'">

    <link name="body_link">
      <visual>
        <origin xyz="0 0 -0.2572" rpy="0 0 1.57"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/RAV_BODY.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 -0.2572" rpy="0 0 1.57"/>
        <geometry>
          <mesh filename="package://rav_description/meshes/RAV_BODY.dae" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 -0.2572" rpy="0 0 1.57"/>
        <mass value="10.0"/>
        <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
      </inertial>
    </link>

    <joint name="platform_to_body_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="body_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

  </xacro:macro>

</robot>