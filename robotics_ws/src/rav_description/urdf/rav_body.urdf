<?xml version="1.0"?>
<robot name="rav_body">

  <link name="base_link"/>

  <link name="body_link">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/RAV_BODY.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="../meshes/RAV_BODY.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

  </link>

  <joint name="body_joint" type="fixed">
    <parent link="base_link"/>
    <child link="body_link"/>
    <origin xyz="0 0 0.2572" rpy="0 0 0"/>
  </joint>

</robot>